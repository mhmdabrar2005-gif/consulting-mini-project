	partition Calendar = calculated
		mode: import
		source =
				
				VAR MinDate = MIN('Employee'[DateOfJoining]) -- Or MIN('Sales'[OrderDate])
				VAR MaxDate = TODAY()                  -- This makes the end date dynamic
				RETURN
				ADDCOLUMNS (
				    CALENDAR(MinDate, MaxDate),
				    "DateKey", FORMAT([Date], "YYYYMMDD"),
				    "Year", YEAR([Date]),
				    "Month", FORMAT([Date], "MMMM"),
				    "MonthNumber", MONTH([Date]),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "WeekNumber", WEEKNUM([Date]),
				    "DayOfWeek", FORMAT([Date], "dddd")
				)

	annotation PBI_Id = 81c5c8e40e614112ac95b093ec7ea86a

